# Server-only keys. Do not expose these with a NUXT_PUBLIC_ prefix.
NUXT_GOOGLE_ROUTES_API_KEY=your_google_routes_api_key
# Browser key for the actual Google map. Enable Maps JavaScript API for this key.
NUXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_javascript_api_key
# Used only when the browser location is unavailable.
NUXT_GOOGLE_ROUTES_ORIGIN=台北車站

# Existing Requirement Agent key.
NUXT_GEMINI_API_KEY=your_gemini_api_key

# --- Firebase（Google 登入 + Firestore + Web Push）---
# Firebase Console → 專案設定 → 一般 → 網頁應用程式
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
# Cloud Messaging → Web configuration → Generate key pair
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_VAPID_KEY=
# 專案設定 → 服務帳戶 → 產生新的私密金鑰，JSON 用 base64 編碼後貼上
NUXT_FIREBASE_SERVICE_ACCOUNT=
# session cookie 加密金鑰（至少 32 字元）
NUXT_SESSION_PASSWORD=
